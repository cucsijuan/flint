{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flint",
  "version": "0.3.0",
  "identifier": "io.github.cucsijuan.flint",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Flint",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "nsis"],
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNDFGMkVBRkUxNDBGQTUKUldTbER4VCs2dkpCTTIvRm8wNVFHTGROa3UyZ2FSalI0bE5uTEluQlhJdXNieU1wd05uWEdZRVcK",
      "endpoints": ["https://github.com/cucsijuan/flint/releases/latest/download/latest.json"]
    }
  }
}
